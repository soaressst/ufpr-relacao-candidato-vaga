# Copie este arquivo para .env e preencha os valores.
# Nunca versione o .env.
# Usadas por pipeline/db.py (app.py, backend/main.py e pipeline/etl_*.py).
# No app publicado (Streamlit Secrets) use o usuário só de leitura (sql/003_usuario_leitura.sql);
# o administrador fica só no .env local, para rodar os ETLs.

DB_USER=
