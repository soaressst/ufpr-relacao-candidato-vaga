				sourceColumn: cand_vaga_realizada

				annotation SummarizationSetBy = Automatic

			partition f_Historico_Concorrencia = m
				mode: import
				source =
						let
						    Fonte = PostgreSQL.Database("localhost:5432", "postgres"),
						    Tabela = Fonte{[Schema="ufpr_analytics",Item="fato_historico_concorrencia"]}[Data]
						in
