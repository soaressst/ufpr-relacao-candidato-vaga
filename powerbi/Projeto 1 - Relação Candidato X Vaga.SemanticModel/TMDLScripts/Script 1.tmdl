			column turno
				dataType: string
				lineageTag: 6c94c3e0-15a7-4c38-92f3-ed6fc5c6269c
				summarizeBy: none
				sourceColumn: turno

				annotation SummarizationSetBy = Automatic

			column grau
				dataType: string
				lineageTag: 3c60d220-b362-4d20-afb9-bf651e9df7d9
				summarizeBy: none
				sourceColumn: grau

				annotation SummarizationSetBy = Automatic

			partition d_Curso = m
				mode: import
				source =
						let
						    Fonte = PostgreSQL.Database("localhost:5432", "postgres"),
						    Tabela = Fonte{[Schema="ufpr_analytics",Item="dim_curso"]}[Data],
						    SemDuplicadas = Table.Distinct(Tabela, {"curso"})
						in
						    SemDuplicadas

			annotation PBI_NavigationStepName = Navegação

			annotation PBI_ResultType = Table

		table d_Campus
			lineageTag: 469756a3-8f02-42dd-b70c-c62d823c7bb2

			column campus
				dataType: string
				lineageTag: 2bdce30d-f1b5-4e29-bea9-3e949cb1e5a4
				summarizeBy: none
				sourceColumn: campus

				annotation SummarizationSetBy = Automatic

			partition d_Campus = m
				mode: import
				source =
						let
						    Fonte = PostgreSQL.Database("localhost:5432", "postgres"),
						    Tabela = Fonte{[Schema="ufpr_analytics",Item="dim_campus"]}[Data],
						    SemDuplicadas = Table.Distinct(Tabela, {"campus"})
						in
						    SemDuplicadas

			annotation PBI_NavigationStepName = Navegação

			annotation PBI_ResultType = Table

		table Parametro_Fator_Impacto
			lineageTag: a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d

			column Fator_Impacto_Percentual
				dataType: double
				formatString: 0.0%
				lineageTag: 2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e
				summarizeBy: none
				sourceColumn: [Value]

				annotation SummarizationSetBy = User

			partition Parametro_Fator_Impacto = calculated
				mode: import
				source = GENERATESERIES(-0.30, 0.30, 0.05)

			annotation PBI_Id = b1c2d3e4f5a6b7c8d9e0

		table _Medidas
			lineageTag: f9920d5c-c61a-4b9d-bd54-215b254c879d

			measure Total_Cursos = COUNTROWS('d_Curso')
				formatString: 0
				lineageTag: cf8804c5-f736-4aa5-ba92-063c6ef68e2c

			measure Media_Concorrencia_2026 =
					
					AVERAGE('f_Previsao_Concorrencia'[cand_vaga_2026])
				formatString: 0.00
				lineageTag: 41f17f37-20b2-4db5-9f0d-00ea7fdab021

			measure Cursos_Com_Sobra =
					
					CALCULATE(
					    COUNTROWS('f_Previsao_Concorrencia'),
					    KEEPFILTERS('f_Previsao_Concorrencia'[ano_entrada_sobra_vagas] <> "Sem Sobra")
					)
				formatString: 0
				lineageTag: b0f14978-40f3-41e4-aa10-e9f3555a9b89

			measure Pct_Cursos_Risco =
					
					DIVIDE([Cursos_Com_Sobra], [Total_Cursos], 0)
				formatString: 0.0%
				lineageTag: d7e5f2a2-dc8f-4908-a02b-f550869d76bb

			measure Valor_Minimo_Medio =
					
					AVERAGE('f_Previsao_Concorrencia'[valor_minimo])
				formatString: 0.00
				lineageTag: e8a123bc-11a2-4433-8812-998877665544

			measure Ano_Minimo_Moda =
					
					MIN('f_Previsao_Concorrencia'[ano_minimo])
				formatString: 0
				lineageTag: a1122334-5566-7788-9900-aabbccddeeff

			measure Historico_Inscritos_Total = 
					
					SUM('f_Historico_Concorrencia'[candidatos_inscritos])
				formatString: #,##0
				lineageTag: 91a2b3c4-d5e6-7f8a-9b0c-1d2e3f4a5b6c

			measure Historico_Media_Cand_Vaga = 
					
					AVERAGE('f_Historico_Concorrencia'[cand_vaga_realizada])
				formatString: 0.00
				lineageTag: 82b3c4d5-e6f7-8a9b-0c1d-2e3f4a5b6c7d

			measure Fator_Simulacao_Selecionado = 
					
					SELECTEDVALUE('Parametro_Fator_Impacto'[Fator_Impacto_Percentual], 0.00)
				formatString: 0.0%
				lineageTag: 73c4d5e6-f7a8-9b0c-1d2e-3f4a5b6c7d8e

			measure Previsao_Simulada_Cand_Vaga = 
					
					VAR MediaBase = [Media_Concorrencia_2026]
					VAR FatorImpacto = [Fator_Simulacao_Selecionado]
					RETURN
					    MediaBase * (1 + FatorImpacto)
				formatString: 0.00
				lineageTag: 64d5e6f7-a8b9-0c1d-2e3f-4a5b6c7d8e9f

			partition _Medidas = m
				mode: import
				source =
						let
						    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
						    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
						    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
						in
						    #"Colunas Removidas"

			annotation PBI_ResultType = Table

		relationship Rel_Curso_Fato
			fromColumn: f_Previsao_Concorrencia.curso
			toColumn: d_Curso.curso

		relationship Rel_Campus_Fato
			fromColumn: f_Previsao_Concorrencia.campus
			toColumn: d_Campus.campus

		relationship Rel_Curso_Historico
			fromColumn: f_Historico_Concorrencia.nome_curso
			toColumn: d_Curso.curso

		relationship Rel_Campus_Historico
			fromColumn: f_Historico_Concorrencia.nome_campus
			toColumn: d_Campus.campus

		cultureInfo pt-BR

		annotation __PBI_TimeIntelligenceEnabled = 1

		annotation PBI_QueryOrder = ["f_Previsao_Concorrencia","f_Historico_Concorrencia","d_Curso","d_Campus","_Medidas","Parametro_Fator_Impacto"]

		annotation PBI_ProTooling = ["TMDLView_Desktop"]