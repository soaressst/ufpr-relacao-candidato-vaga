						    Fonte = Value.NativeQuery(PostgreSQL.Database("localhost:5432", "postgres"), "SELECT * FROM ufpr_analytics.vw_powerbi_concorrencia", null, [EnableFolding=true]),
						    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"previsao_id", Int64.Type}, {"cand_vaga_2026", type number}, {"valor_minimo", type number}, {"ano_minimo", Int64.Type}})
						in
						    #"Tipo Alterado"

			annotation PBI_NavigationStepName = Navegação

