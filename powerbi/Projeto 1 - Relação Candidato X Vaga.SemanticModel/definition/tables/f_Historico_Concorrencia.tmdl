		annotation SummarizationSetBy = Automatic

	partition f_Historico_Concorrencia = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(
				        File.Contents("C:\Users\tiago\OneDrive\Documentos\Liga de Data Science\Projetos\Projeto 1 - Relação Candidato x Vaga\3. Tabela Preditiva\data\gold\historico_candidato_vaga.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(
				        Cabecalhos,
				        {{"Ano", Int64.Type}, {"Concorrentes", type number}, {"Treineiros", type number},
				         {"Vagas", type number}, {"Cand_Vaga", type number}},
				        "en-US"
				    ),
				    ComTurno = Table.AddColumn(Tipos, "turno", each
				        let t = Text.Trim(Text.AfterDelimiter([Curso], " - ", {0, RelativePosition.FromEnd}))
				        in if t = "M" then "Matutino" else if t = "N" then "Noturno"
				           else if t = "V" or t = "T" then "Vespertino" else "Integral", type text),
				    Renomeado = Table.RenameColumns(ComTurno, {
				        {"Ano", "ano_vestibular"}, {"Curso", "nome_curso"}, {"Campus", "nome_campus"},
				        {"Vagas", "vagas_ofertadas"}, {"Concorrentes", "candidatos_inscritos"},
				        {"Cand_Vaga", "cand_vaga_realizada"}, {"Treineiros", "treineiros"}, {"Fonte", "fonte"}
				    })
				in
				    Renomeado

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

